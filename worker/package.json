{
  "name": "passerelle-api",
  "private": true,
  "version": "1.0.0",
  "description": "API Passerelle (Cloudflare Workers + D1) : comptes, synchronisation de la progression et classement.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var ALLOWED_ORIGINS:http://localhost:5173,http://localhost:4174",
    "db:migrate:local": "wrangler d1 migrations apply passerelle --local",
    "db:migrate:remote": "wrangler d1 migrations apply passerelle --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
